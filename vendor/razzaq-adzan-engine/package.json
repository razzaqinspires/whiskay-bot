    "./qibla": "./src/qibla.mjs",
    "./ical": "./src/ical.mjs",
    "./errors": "./src/errors.mjs",
    "./timezone": "./src/timezone.mjs",
    "./hijri": "./src/hijri.mjs",
    "./diagnostics": "./src/diagnostics.mjs",
    "./reference-data": "./src/reference-data.mjs",
    "./device": "./src/device.mjs",
    "./persistence": "./src/persistence.mjs",
    "./api": "./src/api.mjs"
  },
  "scripts": {
    "test": "node --test",
