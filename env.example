# ============================================================================
# WHISKAY BOT · ENVIRONMENT TEMPLATE
# Developer: Arifi Razzaq
# Copy to .env, then fill private values. Never commit .env.
# Optional: export ENV_FILE=.env.production before npm start to use another env file.
# ENV_FILE is a process-level selector, not an editable .env key.
# Empty secret/token values are intentionally left for the owner to fill.
# ============================================================================

# ── 01. Identity & ownership ────────────────────────────────────────────────
BOT_NAME=WhiskayBot
OWNER_NAME=Arifi Razzaq
# Use international format without +; OWNER_PHONE is for the public .owner vCard.
OWNER_PHONE=
# One or more WhatsApp numbers/JIDs, comma-separated. REQUIRED for owner access.
OWNERS=
OWNER_LIDS=
PREFIXES=.,!,/,#
BOT_WHATSAPP_NUMBER=

# ── 02. WhatsApp session & pairing ─────────────────────────────────────────
SESSION_DIR=./sessions
PAIRING_CODE=false
PAIRING_NUMBER=
PAIRING_CUSTOM_CODE=
BOT_BROWSER=Ubuntu
AUTO_CLEAR_SESSION=false
REQUIRE_USER_REGISTRATION=true

# ── 03. Runtime, logging & hot reload ──────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
SOURCE_DIR=./src
PLUGIN_DIR=./src/plugins
SOURCE_RELOAD=false
WATCH_PLUGINS=false
AUTOCLEAN=false
AUTOCLEAN_INTERVAL=300000
AUTOCLEAN_PATHS=./src,./
WHISKAY_DATA_DIR=./data
WHISKAY_GROUP_SETTINGS_FILE=
PORT=
WHISKAY_DB_ARCHIVE_BYTES=1073741824
ENV_RELOAD_ENABLED=true
ENV_RELOAD_DEBOUNCE_MS=650

# ── 04. Nexora / AI providers ───────────────────────────────────────────────
AI_PROVIDER=gemini
AI_CHAT_MODE=auto-private-mention-group
AI_SYSTEM_PROMPT=
OPENAI_API_KEY=
# Multiple keys may be JSON array or comma-separated.
OPENAI_API_KEYS=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash
WHISKAY_IMAGE_MODEL=

# ── 05. Website, RPG & service integrations ─────────────────────────────────
WEBSITE_BASE_URL=https://whiskay-rpg-companion.vercel.app
WEBSITE_API_TOKEN=
WEBSITE_API_TIMEOUT_MS=8000
DUNGEON_WEBSITE_URL=https://whiskay-rpg-companion.vercel.app
DUNGEON_SYNC_TOKEN=
BOT_SYNC_TOKEN=
EGG_CALCULATOR_URL=
RPG_ECONOMY_TIMEOUT_MS=10000
MENU_IMAGE_URL=
RPG_PROFILE_IMAGE_URL=

# ── 06. Cloudflared, Jadibot portal & webhook ────────────────────────────────
# Leave CLOUDFLARED_BIN empty to auto-resolve: data/bin, bin, then PATH.
CLOUDFLARED_BIN=
JADIBOT_BIN_DIR=./data/bin
# auto | on | off (restart required after changing)
JADIBOT_TUNNEL=auto
JADIBOT_DATA_DIR=./data/jadibot
JADIBOT_HOST=127.0.0.1
JADIBOT_PORT=8788
JADIBOT_DEFAULT_DAYS=30
JADIBOT_PRICE_30D=0
JADIBOT_PORTAL_URL=
JADIBOT_PUBLIC_URL=
JADIBOT_PUBLIC_URL_WAIT_MS=25000
JADIBOT_TUNNEL_WAIT_MS=25000
WHISKAY_BOT_WEBHOOK_HOST=0.0.0.0
WHISKAY_BOT_WEBHOOK_PORT=8787
WHISKAY_WEBHOOK_TUNNEL_ENABLED=true
WHISKAY_WEBHOOK_RATE_LIMIT=12
WHISKAY_TUNNEL_RETRY_MS=3000
WHISKAY_TUNNEL_RETRY_MAX_MS=30000
WHISKAY_TUNNEL_START_TIMEOUT_MS=20000
WHISKAY_BOSS_TARGET_GROUPS=
WHISKAY_BOSS_WEBHOOK_SECRET=
# TEAMDROP private document relay: set the same secret in TEAMDROP portal .env.
TEAMDROP_WEBHOOK_SECRET=
# Optional destination; falls back to OWNER_PHONE, first OWNERS entry, then this bot account.
TEAMDROP_WHATSAPP_TO=
TEAMDROP_MAX_FILE_MB=50
TEAMDROP_WEBHOOK_RATE_LIMIT=18
# Generated automatically after TryCloudflare connects; do not commit these URLs.
# WHISKAY_BOT_WEBHOOK_URL=
# WHISKAY_BOT_WEBHOOK_PUBLIC_URL=
WHISKAY_TUNNEL_GITHUB_SYNC=false

# ── 07. GitHub repositories & integration credentials ──────────────────────
WHISKAY_GITHUB_REPO=razzaqinspires/whiskay-bot
WHISKAY_RPG_GITHUB_REPO=razzaqinspires/whiskay-rpg-companion
WHISKAY_RPG_PROJECT_DIR=../whiskay-rpg-companion
GITHUB_TOKEN=
WHISKAY_GITHUB_TOKEN=
WHISKAY_GITHUB_SYNC_TOKEN=
WHISKAY_GITHUB_TRAFFIC_TOKEN=

# ── 08. Downloader providers ───────────────────────────────────────────────
# One or more provider endpoints; separate multiple URLs with commas, semicolons, or newlines.
# Treat these as secrets because endpoint URLs may embed API tokens.
MEDIA_DOWNLOADER_API_URL=
MEDIA_DOWNLOADER_API_URLS=

# ── 09. Group safety, media & feature flags ─────────────────────────────────
ANTILINK_AUTO_KICK=false
ANTILINK_KICK_AFTER=3
SYNTAX_DOCTOR_ENABLED=true
STICKER_PACK_NAME=WhiskayBot
STICKER_AUTHOR=Arifi Razzaq
BOT_LOGO_PATH=
OWNER_AVATAR_PATH=
PYTHON_BIN=python3
SNAKE_LADDERS_PRIZE=0

# ── 10. Optional platform-provided variables ───────────────────────────────
# Usually provided by deployment platforms. Do not set unless your host needs it.
# PORT=
# RAILWAY_PUBLIC_DOMAIN=
# RENDER_EXTERNAL_URL=
# KOYEB_PUBLIC_DOMAIN=
# FLY_APP_NAME=
# VERCEL_URL=
# REPLIT_DOMAINS=
# CODESPACE_NAME=
# GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN=
