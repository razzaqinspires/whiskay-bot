# Whiskay RPG — copy to .env locally. Never commit this file.
# Generate secrets locally; use the same RPG sync secret in both projects.
# Example generator: openssl rand -hex 32
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=REPLACE_WITH_DATABASE_JWT_SECRET_IF_REALTIME_TOKEN_ROUTE_USES_IT
BOT_SYNC_TOKEN=CHANGE_ME_SHARED_RPG_SYNC_SECRET
DUNGEON_SYNC_TOKEN=CHANGE_ME_SHARED_RPG_SYNC_SECRET
NEXT_PUBLIC_# Generate secrets locally; use the same RPG sync secret in both projects.
# Example generator: openssl rand -hex 32
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_KEY
NEXT_PUBLIC_HERO_GLB_URL=/assets/hero.glb
NEXT_PUBLIC_MONSTER_GLB_URL=/assets/monster.glb
WHISKAY_BOT_WEBHOOK_URL=
WHISKAY_BOSS_WEBHOOK_SECRET=CHANGE_ME_SHARED_BOSS_WEBHOOK_SECRET
