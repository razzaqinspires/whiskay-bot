BOT_NAME=WhiskayBot
PREFIXES=.,!,/,#
OWNERS=628xxxxxxxxxx
# Optional: actual Baileys LID identity if available; keep @lid suffix
OWNER_LIDS=
LOG_LEVEL=info

# Razzaq Ventures Next.js website integration (server-side only)
# Set this to the actual production URL shown in Vercel; no trailing slash required.
WEBSITE_BASE_URL=https://razzaq-ventures-platform.vercel.app
# Must exactly match INTEGRATION_API_TOKEN in the Vercel project environment variables.
WEBSITE_API_TOKEN=
WEBSITE_API_TIMEOUT_MS=8000
# Optional official image URLs. Use public direct image URLs (PNG/JPG/WEBP), not a webpage URL.
MENU_IMAGE_URL=

# Optional official RPG profile canvas (public direct image URL)
RPG_PROFILE_IMAGE_URL=
DUNGEON_WEBSITE_URL=https://whiskay-rpg-companion.vercel.app
DUNGEON_SYNC_TOKEN=replace-with-a-long-random-secret
# Optional alias used by the RPG dashboard status command
# rpgsync reads the player snapshot from the website API; game saves push to /api/sync.

# Optional JSON API returning title, thumbnail, videoHD, videoSD, audio
MEDIA_DOWNLOADER_API_URL=

# Stage 9 RPG economy endpoints
RPG_ECONOMY_TIMEOUT_MS=8000

# Stage 13 AI Chat (configure one provider)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_SYSTEM_PROMPT=Kamu adalah WHISKAY AI, asisten virtual yang ramah dan membantu.

# Stage 12 Sticker Maker
STICKER_PACK_NAME=WHISKAY RPG
STICKER_AUTHOR=WHISKAY BOT

# Smart Energy Worker
ENERGY_INITIAL_PERCENT=100
PREMIUM_PRICE_PER_DAY=1000
PREMIUM_MAX_DAYS=30
OWNER_PAYMENT_NOTICE=true

# Optional API key arrays: JSON array or comma-separated values. Keys rotate on failure.
OPENAI_API_KEYS=[]
GEMINI_API_KEYS=[]
AI_PROVIDER=openai
AI_SYSTEM_PROMPT=Kamu adalah WHISKAY AI yang ramah dan membantu.

# Stage 18: protect this port with firewall/private network or HTTPS reverse proxy.
WHISKAY_BOSS_WEBHOOK_PORT=8787
WHISKAY_BOSS_WEBHOOK_HOST=0.0.0.0
WHISKAY_BOSS_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Jadibot rental settings (set your own price before launch)
JADIBOT_DEFAULT_DAYS=30
JADIBOT_PRICE_30D=10000

# Jadibot rental settings (set your own price before launch)
JADIBOT_DEFAULT_DAYS=30
JADIBOT_PRICE_30D=10000

# Public HTTPS URL for the standalone egg calculator service (deploy egg-calculator-server first)
EGG_CALCULATOR_URL=https://calculator.example.com/

# Optional root for persistent group moderation policy (default: ./data)
WHISKAY_DATA_DIR=data
