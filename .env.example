# ============================================================================
# WHISKAY BOT · ENVIRONMENT TEMPLATE
# Developer: Arifi Razzaq
# Copy to .env, then fill private values. Never commit .env.
# Optional: export ENV_FILE=.env.production before npm start to use another env file.
# ENV_FILE is a process-level selector, not an editable .env key.
# Empty secret/token values are intentionally left for the owner to fill.
# ============================================================================

# ── 01. Identity & ownership ────────────────────────────────────────────────
BOT_NAME=WhiskayBot
OWNER_NAME=Arifi Razzaq
# Use international format without +; OWNER_PHONE is for the public .owner vCard.
OWNER_PHONE=
# One or more WhatsApp numbers/JIDs, comma-separated. REQUIRED for owner access.
OWNERS=
OWNER_LIDS=
PREFIXES=.,!,/,#
BOT_WHATSAPP_NUMBER=

# ── 02. WhatsApp session & pairing ─────────────────────────────────────────
SESSION_DIR=./sessions
PAIRING_CODE=false
PAIRING_NUMBER=
PAIRING_CUSTOM_CODE=
BOT_BROWSER=Ubuntu
AUTO_CLEAR_SESSION=false
REQUIRE_USER_REGISTRATION=true

# ── 03. Runtime, logging & hot reload ──────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
SOURCE_DIR=./src
PLUGIN_DIR=./src/plugins
SOURCE_RELOAD=false
WATCH_PLUGINS=false
AUTOCLEAN=false
AUTOCLEAN_INTERVAL=300000
AUTOCLEAN_PATHS=./src,./
WHISKAY_DATA_DIR=./data
WHISKAY_GROUP_SETTINGS_FILE=
PORT=
WHISKAY_DB_ARCHIVE_BYTES=1073741824
ENV_RELOAD_ENABLED=true
ENV_RELOAD_DEBOUNCE_MS=650
ENV_TEMPLATE_SYNC_ENABLED=true
ENV_TEMPLATE_SYNC_PRUNE=true
# Optional custom paths; defaults are .env.example and .env.sync-state beside ENV_FILE.
ENV_TEMPLATE_FILE=
ENV_TEMPLATE_SYNC_STATE_FILE=

# ── Westmanga protected library adapter ─────────────────────────────────────
WESTMANGA_RESPONSE_STYLE=compact
WESTMANGA_DEFAULT_PAGE=1
WESTMANGA_PER_PAGE=10
WESTMANGA_USER_AGENT_PRESET=desktop
# Download root is constrained to WHISKAY_DATA_DIR/downloads/westmanga.
WESTMANGA_DOWNLOAD_DIR=data/downloads/westmanga
WESTMANGA_FALLBACK_ENABLED=true

# ── 04. Nexora / AI providers ───────────────────────────────────────────────
AI_PROVIDER=gemini
AI_CHAT_MODE=mention-only
WHISKAY_AI_PRIVATE_AUTO_ENABLED=false
AI_SYSTEM_PROMPT=Nexora adalah asisten AI dari Razzaq Ventures. Jawab dengan jelas, ramah, jujur, dan relevan. Jangan mengaku memiliki kesadaran, perasaan, atau kemampuan belajar mandiri yang tidak benar-benar tersedia. Utamakan keselamatan, privasi, dan akurasi; nyatakan ketidakpastian bila diperlukan.
OPENAI_API_KEY=
# Multiple keys may be JSON array or comma-separated.
OPENAI_API_KEYS=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash
WHISKAY_IMAGE_MODEL=

# ── 05. Website, RPG & service integrations ─────────────────────────────────
WEBSITE_BASE_URL=https://whiskay-rpg-companion.vercel.app
WEBSITE_API_TOKEN=
WEBSITE_API_TIMEOUT_MS=8000
DUNGEON_WEBSITE_URL=https://whiskay-rpg-companion.vercel.app
DUNGEON_SYNC_TOKEN=
BOT_SYNC_TOKEN=
EGG_CALCULATOR_URL=
RPG_ECONOMY_TIMEOUT_MS=10000
MENU_IMAGE_URL=
RPG_PROFILE_IMAGE_URL=

# ── 06. Cloudflared, Jadibot portal & webhook ────────────────────────────────
# Leave CLOUDFLARED_BIN empty to auto-resolve: data/bin, bin, then PATH.
CLOUDFLARED_BIN=
JADIBOT_BIN_DIR=./data/bin
# auto | on | off (restart required after changing)
JADIBOT_TUNNEL=auto
JADIBOT_DATA_DIR=./data/jadibot
JADIBOT_HOST=127.0.0.1
JADIBOT_PORT=8788
JADIBOT_DEFAULT_DAYS=30
JADIBOT_PRICE_30D=0
JADIBOT_PORTAL_URL=
JADIBOT_PUBLIC_URL=
JADIBOT_PUBLIC_URL_WAIT_MS=25000
JADIBOT_TUNNEL_WAIT_MS=25000
WHISKAY_BOT_WEBHOOK_HOST=0.0.0.0
WHISKAY_BOT_WEBHOOK_PORT=8787
WHISKAY_WEBHOOK_TUNNEL_ENABLED=true
WHISKAY_WEBHOOK_RATE_LIMIT=12
WHISKAY_TUNNEL_RETRY_MS=3000
WHISKAY_TUNNEL_RETRY_MAX_MS=30000
WHISKAY_TUNNEL_START_TIMEOUT_MS=20000
WHISKAY_BOSS_TARGET_GROUPS=
WHISKAY_BOSS_WEBHOOK_SECRET=
# TEAMDROP private document relay: set the same secret in TEAMDROP portal .env.
TEAMDROP_WEBHOOK_SECRET=
# Optional destination; falls back to OWNER_PHONE, then the first OWNERS entry. If neither is set, delivery is disabled.
TEAMDROP_WHATSAPP_TO=
TEAMDROP_MAX_FILE_MB=50
TEAMDROP_WEBHOOK_RATE_LIMIT=18
TEAMDROP_MAX_CONCURRENT_UPLOADS=2
# Only enable when the webhook listener is behind a trusted Cloudflare proxy.
WHISKAY_WEBHOOK_TRUST_CF_CONNECTING_IP=false
WHISKAY_WEBHOOK_REQUEST_TIMEOUT_MS=300000
# Generated automatically after TryCloudflare connects; do not commit these URLs.
# WHISKAY_BOT_WEBHOOK_URL=
# WHISKAY_BOT_WEBHOOK_PUBLIC_URL=
WHISKAY_TUNNEL_GITHUB_SYNC=false

# ── 07. GitHub repositories & integration credentials ──────────────────────
WHISKAY_GITHUB_REPO=razzaqinspires/whiskay-bot
WHISKAY_RPG_GITHUB_REPO=razzaqinspires/whiskay-rpg-companion
WHISKAY_RPG_PROJECT_DIR=../whiskay-rpg-companion
GITHUB_TOKEN=
WHISKAY_GITHUB_TOKEN=
WHISKAY_GITHUB_SYNC_TOKEN=
WHISKAY_GITHUB_TRAFFIC_TOKEN=

# ── 08. Downloader providers ───────────────────────────────────────────────
# One or more provider endpoints; separate multiple URLs with commas, semicolons, or newlines.
# Treat these as secrets because endpoint URLs may embed API tokens.
MEDIA_DOWNLOADER_API_URL=
MEDIA_DOWNLOADER_API_URLS=

# ── 09. Group safety, media & feature flags ─────────────────────────────────
ANTILINK_AUTO_KICK=false
ANTILINK_KICK_AFTER=3
SYNTAX_DOCTOR_ENABLED=true
STICKER_PACK_NAME=WhiskayBot
STICKER_AUTHOR=Arifi Razzaq
BOT_LOGO_PATH=
OWNER_AVATAR_PATH=
PYTHON_BIN=python3
SNAKE_LADDERS_PRIZE=0

# ── 10. Optional platform-provided variables ───────────────────────────────
# Usually provided by deployment platforms. Do not set unless your host needs it.
# PORT=
# RAILWAY_PUBLIC_DOMAIN=
# RENDER_EXTERNAL_URL=
# KOYEB_PUBLIC_DOMAIN=
# FLY_APP_NAME=
# VERCEL_URL=
# REPLIT_DOMAINS=
# CODESPACE_NAME=
# GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN=

# Last successfully assigned TryCloudflare URL (runtime metadata; leave empty in source control).
JADIBOT_LAST_TRYCLOUDFLARE_URL=

# WhatsApp outbound delivery queue and safety policy
# Rate-limit saturation is deferred to the worker; duplicate/quarantine/critical risk stays blocked.
WHISKAY_OUTBOUND_QUEUE_WAIT_MAX_MS=600000
# WhatsApp outbound safety and explicit announcement allowlists
WHISKAY_OUTBOUND_WORKERS=2
WHISKAY_OUTBOUND_MIN_INTERVAL_MS=2000
WHISKAY_OUTBOUND_QUEUE_MAX=150
WHISKAY_OUTBOUND_GLOBAL_MAX_PER_MINUTE=20
WHISKAY_OUTBOUND_RECIPIENT_MAX_PER_MINUTE=4
WHISKAY_OUTBOUND_DUPLICATE_WINDOW_MS=30000

# ── 08. Local Workload Threat Intelligence ──────────────────────────────────
WHISKAY_THREAT_AGENT_ENABLED=true
WHISKAY_THREAT_WORKERS=2
WHISKAY_THREAT_QUEUE_MAX=20
WHISKAY_THREAT_JOB_TIMEOUT_MS=5000
WHISKAY_THREAT_INTERVAL_MS=10000
WHISKAY_THREAT_AUTO_QUARANTINE=true
WHISKAY_THREAT_QUARANTINE_TTL_MS=60000
WHISKAY_BROADCAST_ENABLED=false
WHISKAY_BROADCAST_ALLOWED_GROUPS=
WHISKAY_BROADCAST_ALLOWED_USERS=
WHISKAY_BROADCAST_MAX_TARGETS=5
WHISKAY_BROADCAST_INTERVAL_MS=30000
WHISKAY_BOSS_WEBHOOK_ENABLED=false
WHISKAY_BOSS_MAX_TARGET_GROUPS=5
WHISKAY_BOSS_DELIVERY_INTERVAL_MS=30000

# Stage 66 — opt-in autonomous Git upload repair agent (never bypasses safety gates)
NEXORA_GIT_REPAIR_ENABLED=false
NEXORA_GIT_REPAIR_MAX_ATTEMPTS=3
NEXORA_GIT_REPAIR_TEST_TIMEOUT_MS=120000
NEXORA_GIT_REPAIR_OPENAI_MODEL=gpt-4o-mini
NEXORA_GIT_REPAIR_GEMINI_MODEL=gemini-2.0-flash
# Protected third-party library adapter: Westmanga (Stage 68)
WESTMANGA_RESPONSE_STYLE=compact
WESTMANGA_DEFAULT_PAGE=1
WESTMANGA_PER_PAGE=10
WESTMANGA_USER_AGENT_PRESET=desktop
WESTMANGA_DOWNLOAD_DIR=data/downloads/westmanga
WESTMANGA_FALLBACK_ENABLED=true

# Persistent Baileys message repository (Stage 70.1)
WHISKAY_MESSAGE_REPOSITORY_MAX_ENTRIES=5000
WHISKAY_MESSAGE_REPOSITORY_MAX_BYTES=50331648
WHISKAY_MESSAGE_REPOSITORY_TTL_MS=1209600000

# Nexora autonomous command-error analysis and owner-approved repair workflow
NEXTORA_REPAIR_WORKER_ENABLED=true
NEXTORA_REPAIR_PROVIDER=openai
NEXTORA_REPAIR_MODEL=
# Uses OPENAI_API_KEY or GEMINI_API_KEY according to NEXTORA_REPAIR_PROVIDER.
