BOT_NAME=WhiskayBot
PREFIXES=.,!,/,#
OWNERS=628xxxxxxxxxx
LOG_LEVEL=info

# Razzaq Ventures Next.js website integration (server-side only)
# Set this to the actual production URL shown in Vercel; no trailing slash required.
WEBSITE_BASE_URL=https://razzaq-ventures-platform.vercel.app
# Must exactly match INTEGRATION_API_TOKEN in the Vercel project environment variables.
WEBSITE_API_TOKEN=
WEBSITE_API_TIMEOUT_MS=8000
# Optional official image URLs. Use public direct image URLs (PNG/JPG/WEBP), not a webpage URL.
MENU_IMAGE_URL=

# Optional official RPG profile canvas (public direct image URL)
RPG_PROFILE_IMAGE_URL=
DUNGEON_WEBSITE_URL=https://your-rpg-companion.vercel.app
DUNGEON_SYNC_TOKEN=replace-with-a-long-random-secret
