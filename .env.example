# WhiskayBot Stage 31 — safe example values only. Never commit real secrets.
NODE_ENV=development
OWNERS=6280000000000
PORT=3000
WHISKAY_DATA_DIR=./data

# Website/RPG sync (configure only when the matching server is available)
WEBSITE_BASE_URL=http://localhost:3001
DUNGEON_WEBSITE_URL=http://localhost:3001
BOT_SYNC_TOKEN=replace-with-long-random-secret
DUNGEON_SYNC_TOKEN=replace-with-long-random-secret
RPG_ECONOMY_TIMEOUT_MS=7000
WEBSITE_API_TIMEOUT_MS=7000

# AI/media providers are optional; blank values disable provider-dependent features
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_BASE_URL=
OPENAI_MODEL=
WHISKAY_IMAGE_MODEL=
GITHUB_TOKEN=
WHISKAY_GITHUB_TOKEN=
WHISKAY_GITHUB_TRAFFIC_TOKEN=

# Manual payment settings are stored in data/payment-config.json; no live gateway is enabled by this file.
AI_SYSTEM_PROMPT=You are Nexora, the helpful WhiskayBot assistant. Keep answers safe and concise.
