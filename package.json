{
  "name": "whiskay-bot",
  "version": "2.26.9",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "tunnel:check": "node --input-type=module -e \"import('./src/services/worldBossTunnel.js').then(m=>console.log(m.getWorldBossTunnelStatus()))\"",
    "verify:ops": "node scripts/verify-ops.mjs",
    "verify:stage23": "node --test test/stage23-utils.test.js",
    "verify:all": "npm run verify:ops && npm run verify:stage23 && npm run verify:stage24 && npm run verify:stage25 && npm run verify:stage26 && npm run verify:stage27 && npm run verify:stage28 && npm run verify:stage29 && npm run verify:stage30 && npm run verify:stage31 && npm run verify:stage32 && npm run verify:stage33 && npm run verify:stage34 && npm run verify:stage35 && npm run verify:stage36 && npm run verify:stage37 && npm run verify:stage38 && npm run verify:stage39 && npm run verify:stage40",
    "verify:stage24": "node --test test/stage24-logger.test.js",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "restart:pm2": "pm2 restart ecosystem.config.cjs",
    "stop:pm2": "pm2 stop ecosystem.config.cjs",
    "logs:pm2": "pm2 logs whiskay-bot",
    "verify:stage25": "node --test test/stage25-menfess.test.js",
    "verify:stage26": "node --test test/stage26-observability.test.js",
    "verify:stage27": "node --test test/stage27-outbox.test.js",
    "verify:stage28": "node --test test/stage28-event-processor.test.js",
    "verify:stage29": "node --test test/stage29-menu.test.js",
    "verify:stage30": "node --test test/stage30-recommendations.test.js",
    "verify:stage31": "node --test test/stage31-economy.test.js",
    "verify:stage32": "node --test test/stage32-regression.test.js",
    "verify:stage33": "node --test test/stage33-feature-parity.test.js",
    "verify:stage34": "node --test test/stage34-core.test.js",
    "verify:stage35": "node --test test/stage35-core.test.js",
    "verify:stage36": "node --test test/stage36-event-registry.test.js test/werewolf-engine.test.js",
    "verify:stage37": "node --test test/stage37-parity-manifest.test.js",
    "verify:stage38": "node --test test/stage38-*.test.js",
    "verify:stage39": "node --test test/stage39-*.test.js",
    "verify:stage40": "node --test test/stage40-downloader-parity.test.js test/youtube-download.test.js test/stage40-save-image-path.test.js test/stage40-source-audit.test.js"
  },
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "chokidar": "4.0.3",
    "dotenv": "16.6.1",
    "pino": "9.14.0",
    "pino-pretty": "13.2.0",
    "qrcode-terminal": "0.12.0",
    "chess.js": "^1.4.0"
  }
}
